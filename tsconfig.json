{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "moduleResolution": "node",
    "isolatedModules": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "lib": [
      "DOM",
      "ES2018",
      "ES2021.String"
    ],
    "types": [
      "node"
    ],
    "allowJs": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "esbuild.config.mjs"
  ]
}
